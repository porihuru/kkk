{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve kkk",
      "type": "process",
      "command": "node",
      "args": ["${workspaceFolder}/.vscode/server.js"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(?!)(.*)(.*)$",
          "kind": "file",
          "file": 1,
          "message": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Starting kkk server$",
          "endsPattern": "^Serving HTTP on .*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false
      }
    }
  ]
}
