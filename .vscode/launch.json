{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Edge",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/server.js",
      "args": ["--open"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": false,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
